<Window x:Class="Un0.CustomUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Update Available"
        Height="320" 
        Width="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#0A0A0A"
        AllowsTransparency="True"
        BorderBrush="#1A1A1A"
        BorderThickness="1">

    <Grid>
        <!-- Main Border -->
        <Border CornerRadius="12" Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1" RenderTransformOrigin="0.5,1">
            <Grid Margin="25,20,25,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- Icon -->
                <Border Grid.Row="1" 
                        Width="50" 
                        Height="50" 
                        CornerRadius="25" 
                        Background="#00FF88" 
                        HorizontalAlignment="Center" 
                        Margin="0,0,0,10">
                    <TextBlock Text="⬇" 
                               FontSize="22" 
                               Foreground="#0A0A0A" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Title -->
                <TextBlock Grid.Row="2" 
                           Text="UPDATE AVAILABLE" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Foreground="#00FF88" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,5"/>

                <!-- Subtitle -->
                <TextBlock Grid.Row="3" 
                           Text="A new version is ready for download" 
                           FontSize="12" 
                           Foreground="#AAAAAA" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,12"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>

                <!-- Version Info -->
                <Border Grid.Row="4" 
                        Background="#1A1A1A" 
                        CornerRadius="6" 
                        Padding="10,8" 
                        Margin="0,0,0,12"
                        BorderBrush="#2A2A2A"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Current Version -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="Current" 
                                       FontSize="10" 
                                       Foreground="#666666" 
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="CurrentVersionText" 
                                       Text="v1.2.0" 
                                       FontSize="14" 
                                       FontWeight="SemiBold" 
                                       Foreground="#888888" 
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Arrow -->
                        <TextBlock Grid.Column="1" 
                                   Text="→" 
                                   FontSize="16" 
                                   Foreground="#00FF88" 
                                   VerticalAlignment="Center" 
                                   Margin="10,0,10,0"/>

                        <!-- Latest Version -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="Latest" 
                                       FontSize="10" 
                                       Foreground="#666666" 
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="LatestVersionText" 
                                       Text="v1.3.0" 
                                       FontSize="14" 
                                       FontWeight="SemiBold" 
                                       Foreground="#00FF88" 
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Release Notes -->
                <StackPanel Grid.Row="5" Margin="0,0,0,12">
                    <TextBlock x:Name="ReleaseNotesText" 
                               Text="• Added Volume Booster" 
                               FontSize="11" 
                               Foreground="#AAAAAA" 
                               HorizontalAlignment="Center" 
                               TextWrapping="Wrap" 
                               TextAlignment="Center"
                               MaxWidth="380"/>
                </StackPanel>

                <!-- Update Button Only -->
                <StackPanel Grid.Row="6" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center" 
                            Margin="0,0,0,0">
                    <Button x:Name="UpdateButton" 
                            Content="Update Now" 
                            Width="140" 
                            Height="38" 
                            FontSize="13" 
                            FontWeight="SemiBold"
                            Background="#00FF88" 
                            Foreground="#0A0A0A" 
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="UpdateButton_Click"
                            MouseEnter="Button_MouseEnter" 
                            MouseLeave="Button_MouseLeave">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>