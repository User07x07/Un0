<Window x:Class="Uno.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Un0" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="#0A0A0A"
        MinHeight="600" MinWidth="800">

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" x:Name="TitleBarRow"/>
            <RowDefinition Height="*" x:Name="ContentRow"/>
            <RowDefinition Height="Auto" x:Name="StatusBarRow"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border x:Name="TitleBarBorder" Grid.Row="0" Background="#0A0A0A" Height="45" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <!-- Left: App Icon and Title -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="15,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Un0" FontSize="16" Foreground="#00FF88" 
                               VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock Text=" v1.0.0" FontSize="13" Foreground="#666666" 
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Center: Authentication Status -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" 
                            x:Name="AuthStatusPanel" Visibility="Collapsed">
                    <TextBlock Text="🔐" FontSize="16" Foreground="#00FF88" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Authenticating..." FontSize="12" Foreground="#00FF88" 
                               VerticalAlignment="Center" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Right: Window Controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Button x:Name="MinimizeButton" Content="─" Width="45" Height="35" 
                            Click="MinimizeButton_Click"
                            Background="Transparent" Foreground="#AAAAAA" BorderThickness="0"
                            FontSize="18" Cursor="Hand"
                            MouseEnter="ControlButton_MouseEnter" MouseLeave="ControlButton_MouseLeave"/>
                    <Button x:Name="MaximizeButton" Content="☐" Width="45" Height="35" 
                            Click="MaximizeButton_Click"
                            Background="Transparent" Foreground="#AAAAAA" BorderThickness="0"
                            FontSize="14" Cursor="Hand"
                            MouseEnter="ControlButton_MouseEnter" MouseLeave="ControlButton_MouseLeave"/>
                    <Button x:Name="CloseButton" Content="✕" Width="45" Height="35" 
                            Click="CloseButton_Click"
                            Background="Transparent" Foreground="#AAAAAA" BorderThickness="0"
                            FontSize="16" Cursor="Hand" 
                            MouseEnter="CloseButton_MouseEnter" MouseLeave="CloseButton_MouseLeave"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Progress Bar -->
        <ProgressBar x:Name="LoadProgressBar" Grid.Row="1" VerticalAlignment="Top" Height="2" 
                     Visibility="Collapsed" IsIndeterminate="True"
                     Background="Transparent" Foreground="#00FF88"/>

        <!-- WebView2 Container -->
        <Grid Grid.Row="1" x:Name="WebViewContainer">
            <wv2:WebView2 x:Name="WebView" Margin="0,0,0,0"/>
        </Grid>

        <!-- Status Bar -->
        <Border x:Name="StatusBarBorder" Grid.Row="2" Background="#0A0A0A" Height="32" BorderBrush="#1A1A1A" BorderThickness="0,1,0,0">
            <DockPanel>
                <!-- Left side - Status -->
                <TextBlock x:Name="StatusLabel" Text=" Ready" 
                           Foreground="#666666" VerticalAlignment="Center" Margin="15,0,0,0"
                           FontSize="12" FontFamily="Segoe UI"/>

                <!-- Right side - Protection Status -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="0,0,15,0">
                    <TextBlock x:Name="ProtectionIcon" Text="🛡️" 
                               Foreground="#00FF88" VerticalAlignment="Center" 
                               FontSize="14" Margin="0,0,8,0"/>
                    <TextBlock x:Name="ProtectionLabel" Text="Protected: 0" 
                               Foreground="#00FF88" VerticalAlignment="Center" 
                               FontSize="12" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Fullscreen Overlay Controls (visible when in fullscreen) - FIXED -->
        <Border x:Name="FullscreenControls" Grid.Row="1" Visibility="Collapsed" 
                VerticalAlignment="Bottom" Height="60" Margin="0,0,0,0">
            <Border.Background>
                <LinearGradientBrush EndPoint="0,1" StartPoint="0,0">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#99000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0">
                    <Button x:Name="ExitFullscreenButton" Content="⛶ Exit Fullscreen" 
                            Width="120" Height="35" 
                            Click="ExitFullscreenButton_Click"
                            Background="#333333" Foreground="White" BorderThickness="0"
                            FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                            Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="CloseVideoButton" Content="✕" Width="35" Height="35" 
                            Click="CloseVideoButton_Click"
                            Background="#E81123" Foreground="White" BorderThickness="0"
                            FontSize="16" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>