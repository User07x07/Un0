<Window x:Class="Un0.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Un0" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="#0A0A0A"
        MinHeight="600" MinWidth="800">

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" x:Name="TitleBarRow"/>
            <RowDefinition Height="*" x:Name="ContentRow"/>
            <RowDefinition Height="Auto" x:Name="StatusBarRow"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border x:Name="TitleBarBorder" Grid.Row="0" Background="#0A0A0A" Height="45" 
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <!-- Left: App Icon and Title -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="15,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Un0" FontSize="16" Foreground="#00FF88" 
                               VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionText" Text="" FontSize="13" Foreground="#666666" 
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock x:Name="LatestLabel" Text="" FontSize="11" 
                               Foreground="#90EE90" VerticalAlignment="Center" 
                               Margin="8,0,0,0" Visibility="Collapsed"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Center: Navigation Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Content="◄" Width="35" Height="30" 
                            Click="BackButton_Click" IsEnabled="False"
                            Background="#222222" Foreground="#888888" BorderThickness="0"
                            FontSize="14" Cursor="Hand" Margin="0,0,5,0"
                            MouseEnter="NavButton_MouseEnter" MouseLeave="NavButton_MouseLeave">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="RefreshButton" Content="⟳" Width="35" Height="30" 
                            Click="RefreshButton_Click"
                            Background="#222222" Foreground="#888888" BorderThickness="0"
                            FontSize="16" Cursor="Hand" Margin="5,0,5,0"
                            MouseEnter="NavButton_MouseEnter" MouseLeave="NavButton_MouseLeave">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="HomeButton" Content="🏠" Width="35" Height="30" 
                            Click="HomeButton_Click"
                            Background="#222222" Foreground="#888888" BorderThickness="0"
                            FontSize="12" Cursor="Hand" Margin="5,0,5,0"
                            MouseEnter="NavButton_MouseEnter" MouseLeave="NavButton_MouseLeave">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <!-- Volume Boost Button -->
                    <Button x:Name="VolumeBoostButton" Content="🔊" Width="35" Height="30" 
                    Click="VolumeBoostButton_Click"
                    Background="#222222" Foreground="#888888" BorderThickness="0"
                    FontSize="14" Cursor="Hand" Margin="5,0,0,0"
                    ToolTip="Boost Volume (Click to toggle)"
                    MouseEnter="NavButton_MouseEnter" MouseLeave="NavButton_MouseLeave">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <!-- Right: Window Controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Button x:Name="UpdateButton" Content="↻" Width="35" Height="35" 
                            Click="UpdateButton_Click"
                            Background="Transparent" Foreground="#00FF88" BorderThickness="0"
                            FontSize="16" Cursor="Hand"
                            ToolTip="Check for updates"
                            MouseEnter="ControlButton_MouseEnter" MouseLeave="ControlButton_MouseLeave"/>
                    <Button x:Name="MinimizeButton" Content="─" Width="45" Height="35" 
                            Click="MinimizeButton_Click"
                            Background="Transparent" Foreground="#AAAAAA" BorderThickness="0"
                            FontSize="18" Cursor="Hand"
                            MouseEnter="ControlButton_MouseEnter" MouseLeave="ControlButton_MouseLeave"/>
                    <Button x:Name="MaximizeButton" Content="☐" Width="45" Height="35" 
                            Click="MaximizeButton_Click"
                            Background="Transparent" Foreground="#AAAAAA" BorderThickness="0"
                            FontSize="14" Cursor="Hand"
                            MouseEnter="ControlButton_MouseEnter" MouseLeave="ControlButton_MouseLeave"/>
                    <Button x:Name="CloseButton" Content="✕" Width="45" Height="35" 
                            Click="CloseButton_Click"
                            Background="Transparent" Foreground="#AAAAAA" BorderThickness="0"
                            FontSize="16" Cursor="Hand" 
                            MouseEnter="CloseButton_MouseEnter" MouseLeave="CloseButton_MouseLeave"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Progress Bar -->
        <ProgressBar x:Name="LoadProgressBar" Grid.Row="1" VerticalAlignment="Top" Height="2" 
                     Visibility="Collapsed" IsIndeterminate="True"
                     Background="Transparent" Foreground="#00FF88"/>

        <!-- WebView2 Container -->
        <Grid Grid.Row="1" x:Name="WebViewContainer">
            <Border x:Name="WebViewBorder" Background="Transparent" CornerRadius="0">
                <wv2:WebView2 x:Name="WebView" Margin="0,0,0,0"/>
            </Border>
            <!-- Update Overlay (initially hidden) -->
            <Grid x:Name="UpdateOverlay" Visibility="Collapsed" 
                  Background="#CC0A0A0A" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⚠️" Foreground="#FF4444" FontSize="48" 
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="UPDATE REQUIRED" Foreground="#FF4444" FontSize="28" 
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Please update to the latest version to continue using Un0." 
                               Foreground="#CCCCCC" FontSize="16" 
                               HorizontalAlignment="Center" Margin="0,0,0,20"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="500"/>
                    <Button x:Name="OverlayUpdateButton" Content="Check for Updates" 
                            Width="200" Height="45" FontSize="14" FontWeight="SemiBold"
                            Background="#00FF88" Foreground="#0A0A0A" BorderThickness="0"
                            Cursor="Hand" HorizontalAlignment="Center"
                            Click="UpdateButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border x:Name="StatusBarBorder" Grid.Row="2" Background="#0A0A0A" Height="32" 
        BorderBrush="#1A1A1A" BorderThickness="0,1,0,0">
            <DockPanel>
                <!-- Left side - Status -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock x:Name="StatusLabel" Text=" Ready" 
                       Foreground="#666666" VerticalAlignment="Center" Margin="15,0,0,0"
                       FontSize="12" FontFamily="Segoe UI"/>
                    <!-- Update status icon (visible when update is available) -->
                    <TextBlock x:Name="UpdateStatusIcon" Text="⚠️" Foreground="#FF4444" 
                       FontSize="12" VerticalAlignment="Center" Margin="5,0,0,0" 
                       Visibility="Collapsed"/>
                </StackPanel>

                <!-- Center - Update Warning Label (prominent warning) -->
                <TextBlock x:Name="UpdateWarningLabel" Text="⚠️ Please Update to the Latest Version" 
                   Foreground="#FF4444" VerticalAlignment="Center" 
                   FontSize="11" FontFamily="Segoe UI" FontWeight="SemiBold"
                   HorizontalAlignment="Center" DockPanel.Dock="Left"
                   Margin="20,0,0,0" Visibility="Collapsed"/>

                <!-- Right side - Protection Status -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="0,0,15,0">
                    <TextBlock x:Name="ProtectionIcon" Text="🛡️" 
                       Foreground="#00FF88" VerticalAlignment="Center" 
                       FontSize="14" Margin="0,0,8,0"/>
                    <TextBlock x:Name="ProtectionLabel" Text="Protected: 0" 
                       Foreground="#00FF88" VerticalAlignment="Center" 
                       FontSize="12" FontFamily="Segoe UI" FontWeight="SemiBold"/>

                    <!-- Keyboard Shortcut Hint -->
                    <TextBlock x:Name="FullscreenHint" Text="Press 'F' to Toggle Fullscreen" 
                       Foreground="#444444" VerticalAlignment="Center" 
                       FontSize="10" FontFamily="Segoe UI"
                       Margin="15,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Fullscreen Overlay Controls (visible when in fullscreen) -->
        <Border x:Name="FullscreenControls" Grid.Row="1" Visibility="Collapsed" 
                VerticalAlignment="Bottom" Height="60" Margin="0,0,0,0">
            <Border.Background>
                <LinearGradientBrush EndPoint="0,1" StartPoint="0,0">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#99000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0">
                    <Button x:Name="ExitFullscreenButton" Content="⛶ Exit Fullscreen" 
                            Width="120" Height="35" 
                            Click="ExitFullscreenButton_Click"
                            Background="#333333" Foreground="White" BorderThickness="0"
                            FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                            Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="CloseVideoButton" Content="✕" Width="35" Height="35" 
                            Click="CloseVideoButton_Click"
                            Background="#E81123" Foreground="White" BorderThickness="0"
                            FontSize="16" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>