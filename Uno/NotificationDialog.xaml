<Window x:Class="Un0.NotificationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Un0"
        Height="220" Width="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Opacity="0">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#00BFA5"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#00A693"/>
        <SolidColorBrush x:Key="CardBackground" Color="#141414"/>
        <SolidColorBrush x:Key="HeaderBackground" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9E9E9E"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2A2A2A"/>

        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="Foreground" Value="#0D0D0D"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Pop-up animation -->
        <Storyboard x:Key="PopupAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.85" To="1" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.85" To="1" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Window.RenderTransform>
        <ScaleTransform ScaleX="1" ScaleY="1"/>
    </Window.RenderTransform>

    <Border Background="{StaticResource CardBackground}" 
            CornerRadius="12" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" 
                              ShadowDepth="8" 
                              Direction="270" 
                              Color="Black" 
                              Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" 
                    Background="{StaticResource HeaderBackground}" 
                    CornerRadius="12,12,0,0"
                    Height="42">
                <Grid>
                    <TextBlock Text="Un0" 
                               Foreground="{StaticResource TextPrimary}" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"/>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="20,24,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <Border Grid.Column="0" 
                        Width="44" 
                        Height="44" 
                        CornerRadius="22" 
                        Background="#00BFA520"
                        Margin="0,0,16,0"
                        VerticalAlignment="Top">
                    <TextBlock Text="&#xE946;" 
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Message -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Already Running" 
                               Foreground="{StaticResource TextPrimary}" 
                               FontSize="16" 
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Un0 is already running. Only one instance can run at a time." 
                               Foreground="{StaticResource TextSecondary}" 
                               FontSize="13"
                               TextWrapping="Wrap"
                               LineHeight="20"/>
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" 
                    Background="{StaticResource CardBackground}" 
                    CornerRadius="0,0,12,12"
                    Padding="20,10,20,16">
                <Button Content="OK" 
                        Style="{StaticResource DialogButtonStyle}"
                        HorizontalAlignment="Right"
                        Click="OkButton_Click"/>
            </Border>
        </Grid>
    </Border>
</Window>